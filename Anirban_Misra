import asyncio
import websockets
import json
import re
import math

# Safety thresholds
SAFE_ALTITUDE_LIMITS = {
    "GREEN": 500,
    "YELLOW": 999,
    "RED": 2
}
TARGET_ALTITUDES = {
    "GREEN": 450,
    "YELLOW": 900,
    "RED": 1
}
MAX_SPEED = 5
BATTERY_LOW_THRESHOLD = 20
TILT_THRESHOLD = 45
MAX_X_RANGE = 100000

# Telemetry parser
def parse_telemetry(telemetry_str):
    pattern = r"X-(?P<x>-?\d+)-Y-(?P<y>-?\d+)-BAT-(?P<battery>\d+)-GYR-\[(?P<gx>-?\d+),(?P<gy>-?\d+),(?P<gz>-?\d+)\]-WIND-(?P<wind>\d+)-DUST-(?P<dust>\d+)-SENS-(?P<sensor>\w+)"
    match = re.search(pattern, telemetry_str)
    if not match:
        return None
    return {
        "x": int(match["x"]),
        "y": int(match["y"]),
        "battery": int(match["battery"]),
        "gyroscope": (int(match["gx"]), int(match["gy"]), int(match["gz"])),
        "wind": int(match["wind"]),
        "dust": int(match["dust"]),
        "sensor": match["sensor"]
    }

# Gyroscope-based tilt calculation using angle
def calculate_tilt(gx, gy, gz):
    magnitude = math.sqrt(gx**2 + gy**2 + gz**2)
    if magnitude == 0:
        return 0
    cos_theta = gz / magnitude
    angle_rad = math.acos(max(min(cos_theta, 1), -1))  # Clamp to [-1, 1]
    angle_deg = math.degrees(angle_rad)
    return angle_deg

# Determine smooth target altitude
def determine_altitude_change(current_altitude, sensor_status):
    target = TARGET_ALTITUDES.get(sensor_status, 200)
    if current_altitude < target - 10:
        return 1
    elif current_altitude > target + 10:
        return -1
    return 0

# Dynamic speed logic
def determine_speed(battery, tilt, phase):
    if phase == "early":
        return MAX_SPEED if tilt < 30 else 3
    if battery < BATTERY_LOW_THRESHOLD or tilt > TILT_THRESHOLD:
        return 2
    elif battery > 80 and tilt < 10:
        return MAX_SPEED
    return 3

# Main control loop
async def drone_controller():
    uri = "ws://localhost:8765"
    early_phase = True
    try:
        async with websockets.connect(uri) as websocket:
            await websocket.send(json.dumps({
                "speed": 2,
                "altitude": 1,
                "movement": "fwd"
            }))

            while True:
                message = await websocket.recv()
                data = json.loads(message)

                if data["status"] == "crashed":
                    print("[!] Drone crashed!")
                    break

                telemetry = parse_telemetry(data["telemetry"])
                if not telemetry:
                    print("[!] Failed to parse telemetry")
                    continue

                x = telemetry["x"]
                y = telemetry["y"]
                battery = telemetry["battery"]
                gx, gy, gz = telemetry["gyroscope"]
                sensor = telemetry["sensor"]

                tilt = calculate_tilt(gx, gy, gz)

                if battery < 70:
                    early_phase = False

                altitude_change = determine_altitude_change(y, sensor)
                speed = determine_speed(battery, tilt, "early" if early_phase else "normal")

                if abs(x) > MAX_X_RANGE:
                    print("[!] Drone range exceeded.")
                    break

                command = {
                    "speed": speed,
                    "altitude": altitude_change,
                    "movement": "fwd"
                }

                print(f"[Tick] X={x}, Alt={y}, Bat={battery}%, Tilt={tilt:.1f}°, Speed={speed}, Sensor={sensor}")
                await websocket.send(json.dumps(command))
                await asyncio.sleep(0.1)

    except Exception as e:
        print(f"[!] Error: {e}")

# Run the loop
if __name__ == "__main__":
    asyncio.run(drone_controller())

